# ============================================================
# AI PROVIDERS — tried in order, first success wins.
# Any provider whose key is missing is skipped automatically.
# ============================================================
AI_PROVIDERS=gemini,groq,ollama

# Gemini free tier — works from GitHub Actions. Key: ai.google.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq free tier — very fast, generous limits. Key: console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — fully local, zero cost. Only works where Ollama is running.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ============================================================
# DATA SOURCES (all free)
# ============================================================

# Reddit — create a "script" app at reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-crypto-content-engine/1.0 by yourusername
REDDIT_SUBREDDITS=CryptoCurrency,ethtrader,web3,gamedev,esports

# Farcaster via Neynar free tier — optional but high signal for Web3
NEYNAR_API_KEY=
FARCASTER_CHANNELS=gaming,base,ethereum

# YouTube Data API — powers competition + view-velocity in the Opportunity Score.
# Free key: console.cloud.google.com -> enable "YouTube Data API v3" -> API key.
YOUTUBE_API_KEY=
# Optional: channel IDs for the YouTube RSS source (comma separated).
YOUTUBE_CHANNEL_IDS=

# Hacker News — no key needed, just search terms
HN_QUERIES=web3 gaming,play to earn,gamefi,blockchain game,esports crypto,gaming nft

# Google News search RSS (no key) — aggregates 100s of outlets for gaming news.
GOOGLE_NEWS_QUERIES=web3 gaming,GameFi,play to earn,blockchain game,crypto gaming

# YouTube search — recent gaming videos with real view counts (uses YOUTUBE_API_KEY).
YT_SEARCH_QUERIES=web3 gaming,GameFi,play to earn crypto,blockchain game

# GitHub — powers the Build Log pillar from your real commits.
# Format: owner/repo,owner/repo. Token optional (higher rate limit + private repos).
GITHUB_REPOS=
GITHUB_TOKEN=

# ============================================================
# STORAGE — a local Excel file. Nothing to set up.
# Each run writes one row: viral topic + a draft per platform.
# ============================================================
# Default: ./data/content-engine.xlsx. Uncomment to change location.
# EXCEL_FILE=

# ============================================================
# CONTENT SETTINGS
# ============================================================
# Your niche — steers the viral filter, research, and drafts.
CONTENT_FOCUS=Web3 gaming, esports monetization, streamer micropayments, GameReq founder perspective

# Override the daily pillar rotation (optional):
# founder_story | market_insight | technical_explainer | build_log | ecosystem_commentary
PILLAR_OVERRIDE=

# true = generate a fresh post every run (skip the "already ran today" guard).
FORCE_RERUN=true
